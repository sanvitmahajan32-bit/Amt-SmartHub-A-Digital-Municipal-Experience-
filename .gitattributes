# Auto detect text files and normalize line endings to LF
* text=auto

# Explicitly declare text files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Declare binary files
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
